generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  KITCHEN_STAFF
  STUDENT
}

enum UserStatus {
  ACTIVE
  LOCKED
  INACTIVE
}

enum StudentDirectoryStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum DiningType {
  DINE_IN
  TAKEAWAY
}

enum PickupType {
  ASAP
  SCHEDULED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  VNPAY_QR_MOCK
  CANTEEN_WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
}

enum KitchenTaskStatus {
  WAITING
  CLAIMED
  PREPARING
  DONE
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletTransactionType {
  TOP_UP
  WITHDRAWAL
  PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
}

enum WalletRequestType {
  DEPOSIT
  WITHDRAWAL
}

enum WalletRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoyaltyTransactionType {
  EARN
  SPEND
  VOUCHER_EXCHANGE
  REFUND
  ADMIN_ADJUSTMENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_ITEM
}

enum StudentVoucherStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum InventoryReservationStatus {
  RESERVED
  PARTIALLY_CONSUMED
  CONSUMED
  RELEASED
}

enum InventoryReservationItemStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum InventoryTransactionType {
  STOCK_IN
  RESERVE
  CONSUME
  RELEASE
  ADJUSTMENT
  WASTE
}

enum StockReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEFT_EARLY
}

enum NotificationType {
  ORDER
  PAYMENT
  WALLET
  LOYALTY
  VOUCHER
  SYSTEM
}

enum PickupTokenStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                Role
  avatarUrl           String?
  status              UserStatus           @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  studentProfile      StudentProfile?
  employeeProfile     EmployeeProfile?
  orderChanges        OrderStatusHistory[]
  notifications       Notification[]
  chatMessages        ChatMessage[]
  chatParticipants    ChatParticipant[]
  attendanceAudits    AttendanceAudit[]    @relation("AttendanceAuditActor")
  auditLogs           AuditLog[]

  @@index([role, status])
  @@index([createdAt])
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  familyId     String
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  @@index([userId, familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, expiresAt])
}

model StudentDirectory {
  id             String                 @id @default(cuid())
  studentCode    String                 @unique
  schoolEmail    String                 @unique
  fullName       String
  faculty        String
  major          String
  className      String
  academicYear   String
  status         StudentDirectoryStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  studentProfile StudentProfile?
  @@index([status])
  @@index([fullName])
}

model StudentProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  studentDirectoryId String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentDirectory   StudentDirectory   @relation(fields: [studentDirectoryId], references: [id])
  wallet             Wallet?
  loyaltyAccount     LoyaltyAccount?
  cart               Cart?
  orders             Order[]
  favorites          Favorite[]
  couponUsages       CouponUsage[]
  studentVouchers    StudentVoucher[]
  reviews            Review[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model EmployeeProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  employeeCode  String         @unique
  fullName      String
  phone         String?
  workRole      Role
  status        EmployeeStatus @default(ACTIVE)
  hireDate      DateTime       @db.Date
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts        Shift[]
  attendances   Attendance[]
  kitchenTasks  KitchenTask[]
  stockReceipts StockReceipt[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  @@index([workRole, status])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String    @default("🍽️")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                     String                   @id @default(cuid())
  categoryId             String
  category               Category                 @relation(fields: [categoryId], references: [id])
  name                   String
  slug                   String                   @unique
  description            String
  basePrice              Int
  imageUrl               String?
  preparationTimeMinutes Int                      @default(10)
  calories               Int?
  isVegetarian           Boolean                  @default(false)
  isAvailable            Boolean                  @default(true)
  averageRating          Decimal                  @default(0) @db.Decimal(3, 2)
  totalReviews           Int                      @default(0)
  variants               ProductVariant[]
  optionGroups           ProductOptionGroupLink[]
  comboItems             ComboItem[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  favorites              Favorite[]
  reviews                Review[]
  recipes                Recipe[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?
  @@index([categoryId, isAvailable])
  @@index([name])
  @@index([averageRating])
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String      @unique
  priceAdjustment Int         @default(0)
  active          Boolean     @default(true)
  cartItems       CartItem[]
  comboItems      ComboItem[]
  recipes         Recipe[]
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@unique([productId, name])
  @@index([productId, active])
}

model ProductOptionGroup {
  id           String                   @id @default(cuid())
  name         String
  slug         String                   @unique
  minSelect    Int                      @default(0)
  maxSelect    Int                      @default(1)
  isRequired   Boolean                  @default(false)
  values       ProductOptionValue[]
  productLinks ProductOptionGroupLink[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model ProductOptionValue {
  id              String             @id @default(cuid())
  optionGroupId   String
  optionGroup     ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Int                @default(0)
  sortOrder       Int                @default(0)
  active          Boolean            @default(true)
  cartItemOptions CartItemOption[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@unique([optionGroupId, name])
  @@index([optionGroupId, active])
}

model ProductOptionGroupLink {
  productId     String
  optionGroupId String
  sortOrder     Int                @default(0)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup   ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  @@id([productId, optionGroupId])
}

model Combo {
  id                     String      @id @default(cuid())
  name                   String
  slug                   String      @unique
  description            String
  imageUrl               String?
  calculatedPrice        Int
  originalPrice          Int
  discountPercentage     Int         @default(10)
  preparationTimeMinutes Int         @default(15)
  isActive               Boolean     @default(true)
  items                  ComboItem[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?
  @@index([isActive])
}

model ComboItem {
  id        String          @id @default(cuid())
  comboId   String
  productId String
  variantId String?
  quantity  Int             @default(1)
  combo     Combo            @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])
  variant   ProductVariant?  @relation(fields: [variantId], references: [id])
  @@unique([comboId, productId, variantId])
  @@index([productId])
}

model Favorite {
  studentProfileId String
  productId        String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  @@id([studentProfileId, productId])
}

model Cart {
  id               String         @id @default(cuid())
  studentProfileId String         @unique
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  items            CartItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String?
  comboId   String?
  variantId String?
  quantity  Int             @default(1)
  note      String?
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id])
  combo     Combo?          @relation(fields: [comboId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  options   CartItemOption[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  @@index([cartId])
}

model CartItemOption {
  cartItemId    String
  optionValueId String
  cartItem      CartItem           @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id])
  @@id([cartItemId, optionValueId])
}

model OrderDailyCounter {
  date  DateTime @id @db.Date
  value Int      @default(0)
}

model Order {
  id                   String          @id @default(cuid())
  orderCode            String          @unique
  idempotencyKey       String          @unique
  studentProfileId     String
  studentProfile       StudentProfile  @relation(fields: [studentProfileId], references: [id])
  diningType           DiningType
  pickupType           PickupType
  scheduledPickupAt    DateTime?
  subtotal             Int
  comboSavings         Int             @default(0)
  couponDiscount       Int             @default(0)
  voucherDiscount      Int             @default(0)
  pointDiscount        Int             @default(0)
  discountTotal        Int             @default(0)
  totalAmount          Int
  pointsUsed           Int             @default(0)
  status               OrderStatus     @default(PENDING)
  paymentStatus        PaymentStatus   @default(PENDING)
  paymentMethod        PaymentMethod
  couponId             String?
  coupon               Coupon?         @relation(fields: [couponId], references: [id])
  studentVoucherId     String?         @unique
  studentVoucher       StudentVoucher? @relation(fields: [studentVoucherId], references: [id])
  note                 String?
  cancellationReason   String?
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  pickupToken          OrderPickupToken?
  payments             Payment[]
  couponUsage          CouponUsage?
  walletTransactions   WalletTransaction[]
  loyaltyTransactions  LoyaltyTransaction[]
  inventoryReservation InventoryReservation?
  chatRoom             ChatRoom?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  acceptedAt           DateTime?
  readyAt              DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  @@index([studentProfileId, createdAt])
  @@index([status, scheduledPickupAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id                      String      @id @default(cuid())
  orderId                 String
  productId               String?
  comboId                 String?
  variantId               String?
  quantity                Int
  productNameSnapshot     String
  variantNameSnapshot     String?
  unitPriceSnapshot       Int
  selectedOptionsSnapshot Json?
  lineSubtotal            Int
  note                    String?
  requiresKitchen         Boolean     @default(true)
  order                   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                 Product?    @relation(fields: [productId], references: [id])
  combo                   Combo?      @relation(fields: [comboId], references: [id])
  variant                 ProductVariant? @relation(fields: [variantId], references: [id])
  options                 OrderItemOption[]
  kitchenTask             KitchenTask?
  review                  Review?
  reservationItems        InventoryReservationItem[]
  createdAt               DateTime    @default(now())
  @@index([orderId])
  @@index([productId])
}

model OrderItemOption {
  id                      String    @id @default(cuid())
  orderItemId             String
  optionGroupNameSnapshot String
  optionValueNameSnapshot String
  priceAdjustmentSnapshot Int       @default(0)
  orderItem               OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  oldStatus       OrderStatus?
  newStatus       OrderStatus
  changedByUserId String?
  note            String?
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?        @relation(fields: [changedByUserId], references: [id])
  createdAt       DateTime     @default(now())
  @@index([orderId, createdAt])
}

model OrderPickupToken {
  id        String            @id @default(cuid())
  orderId   String            @unique
  tokenHash String            @unique
  tokenHint String
  status    PickupTokenStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  @@index([status, expiresAt])
}

model KitchenTask {
  id          String            @id @default(cuid())
  orderItemId String            @unique
  employeeId  String?
  status      KitchenTaskStatus @default(WAITING)
  claimedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  employee    EmployeeProfile?  @relation(fields: [employeeId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([status, createdAt])
  @@index([employeeId, status])
}

model Payment {
  id             String                 @id @default(cuid())
  orderId        String
  order          Order                  @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  type           PaymentTransactionType @default(CHARGE)
  status         PaymentStatus          @default(PENDING)
  amount         Int
  providerRef    String?                @unique
  idempotencyKey String                 @unique
  qrPayload      String?
  paidAt         DateTime?
  failedAt       DateTime?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model Wallet {
  id               String         @id @default(cuid())
  studentProfileId String         @unique
  balance          Int            @default(0)
  status           WalletStatus   @default(ACTIVE)
  bankName         String?
  bankAccountNumber String?
  bankAccountName  String?
  bankLinkedAt     DateTime?
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]
  requests         WalletRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WalletRequest {
  id               String              @id @default(cuid())
  requestCode      String              @unique
  walletId         String
  type             WalletRequestType
  amount           Int
  method           String?
  status           WalletRequestStatus @default(PENDING)
  note             String?
  adminNote        String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  wallet           Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([walletId, createdAt])
  @@index([status, createdAt])
}

model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  orderId       String?
  type          WalletTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String
  reference     String                @unique
  metadata      Json?
  wallet        Wallet                @relation(fields: [walletId], references: [id])
  order         Order?                @relation(fields: [orderId], references: [id])
  createdAt     DateTime              @default(now())
  @@index([walletId, createdAt])
  @@index([orderId])
}

model LoyaltyAccount {
  id               String               @id @default(cuid())
  studentProfileId String               @unique
  points           Int                  @default(0)
  studentProfile   StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  transactions     LoyaltyTransaction[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model LoyaltyTransaction {
  id               String                 @id @default(cuid())
  loyaltyAccountId String
  orderId          String?
  type             LoyaltyTransactionType
  points           Int
  balanceBefore    Int
  balanceAfter     Int
  description      String
  reference        String                 @unique
  loyaltyAccount   LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id])
  order            Order?                 @relation(fields: [orderId], references: [id])
  createdAt        DateTime               @default(now())
  @@index([loyaltyAccountId, createdAt])
  @@index([orderId])
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  description       String
  type              DiscountType
  discountValue     Int
  minimumOrderValue Int          @default(0)
  maximumDiscount   Int?
  startAt           DateTime
  expireAt          DateTime
  usageLimit        Int?
  usageCount        Int          @default(0)
  perStudentLimit   Int          @default(1)
  requiresCombo     Boolean      @default(false)
  freeProductId     String?
  isActive          Boolean      @default(true)
  orders            Order[]
  usages            CouponUsage[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  @@index([isActive, startAt, expireAt])
}

model CouponUsage {
  id               String         @id @default(cuid())
  couponId         String
  studentProfileId String
  orderId          String         @unique
  discountAmount   Int
  coupon           Coupon         @relation(fields: [couponId], references: [id])
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  @@index([couponId, studentProfileId])
}

model Voucher {
  id                String           @id @default(cuid())
  code              String           @unique
  name              String
  description       String
  discountType      DiscountType
  discountValue     Int
  requiredPoints    Int
  totalQuantity     Int
  remainingQuantity Int
  minimumOrderValue Int              @default(0)
  maximumDiscount   Int?
  startAt           DateTime
  expireAt          DateTime
  perStudentLimit   Int              @default(1)
  isActive          Boolean          @default(true)
  studentVouchers   StudentVoucher[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  @@index([isActive, startAt, expireAt])
}

model StudentVoucher {
  id               String               @id @default(cuid())
  studentProfileId String
  voucherId        String
  serialCode       String               @unique
  status           StudentVoucherStatus @default(ACTIVE)
  redeemedAt       DateTime             @default(now())
  usedAt           DateTime?
  studentProfile   StudentProfile       @relation(fields: [studentProfileId], references: [id])
  voucher          Voucher              @relation(fields: [voucherId], references: [id])
  order            Order?
  @@index([studentProfileId, status])
  @@index([voucherId, studentProfileId])
}

model Ingredient {
  id                String                     @id @default(cuid())
  name              String                     @unique
  unit              String
  currentQuantity   Decimal                    @default(0) @db.Decimal(18, 3)
  reservedQuantity  Decimal                    @default(0) @db.Decimal(18, 3)
  lowStockThreshold Decimal                    @default(0) @db.Decimal(18, 3)
  reorderThreshold  Decimal                    @default(0) @db.Decimal(18, 3)
  costPerUnit       Int                        @default(0)
  active            Boolean                    @default(true)
  recipeIngredients RecipeIngredient[]
  reservationItems  InventoryReservationItem[]
  transactions      InventoryTransaction[]
  stockReceiptItems StockReceiptItem[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  @@index([active])
}

model Recipe {
  id          String          @id @default(cuid())
  productId   String
  variantId   String?
  name        String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  ingredients RecipeIngredient[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@unique([productId, variantId])
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     Decimal    @db.Decimal(18, 3)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([recipeId, ingredientId])
}

model InventoryReservation {
  id        String                     @id @default(cuid())
  orderId   String                     @unique
  status    InventoryReservationStatus @default(RESERVED)
  order     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     InventoryReservationItem[]
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  @@index([status, createdAt])
}

model InventoryReservationItem {
  id            String                         @id @default(cuid())
  reservationId String
  ingredientId  String
  orderItemId    String
  quantity      Decimal                        @db.Decimal(18, 3)
  status        InventoryReservationItemStatus @default(RESERVED)
  reservation   InventoryReservation           @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ingredient    Ingredient                     @relation(fields: [ingredientId], references: [id])
  orderItem     OrderItem                      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  @@unique([reservationId, orderItemId, ingredientId])
  @@index([ingredientId, status])
}

model InventoryTransaction {
  id             String                   @id @default(cuid())
  ingredientId   String
  type           InventoryTransactionType
  quantity       Decimal                  @db.Decimal(18, 3)
  quantityBefore Decimal                  @db.Decimal(18, 3)
  quantityAfter  Decimal                  @db.Decimal(18, 3)
  reservedBefore Decimal                  @db.Decimal(18, 3)
  reservedAfter  Decimal                  @db.Decimal(18, 3)
  referenceType  String?
  referenceId    String?
  note           String?
  ingredient     Ingredient               @relation(fields: [ingredientId], references: [id])
  createdAt      DateTime                 @default(now())
  @@index([ingredientId, createdAt])
  @@index([referenceType, referenceId])
}

model Supplier {
  id            String         @id @default(cuid())
  name          String
  contactName   String
  phone         String
  email         String?
  address       String
  status        EmployeeStatus @default(ACTIVE)
  stockReceipts StockReceipt[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  @@index([status])
}

model StockReceipt {
  id          String             @id @default(cuid())
  receiptCode String             @unique
  supplierId  String
  employeeId  String
  receivedAt  DateTime
  totalCost   Int                @default(0)
  note        String?
  status      StockReceiptStatus @default(DRAFT)
  confirmedAt DateTime?
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  employee    EmployeeProfile    @relation(fields: [employeeId], references: [id])
  items       StockReceiptItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@index([supplierId, receivedAt])
  @@index([status])
}

model StockReceiptItem {
  id             String       @id @default(cuid())
  stockReceiptId String
  ingredientId   String
  quantity       Decimal      @db.Decimal(18, 3)
  unitCost       Int
  lineTotal      Int
  stockReceipt   StockReceipt @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id])
  @@unique([stockReceiptId, ingredientId])
}

model Shift {
  id         String          @id @default(cuid())
  employeeId String
  date       DateTime        @db.Date
  startTime  String
  endTime    String
  workRole   Role
  note       String?
  status     ShiftStatus     @default(SCHEDULED)
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id])
  attendance Attendance?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  @@index([employeeId, date])
  @@index([date, workRole])
}

model Attendance {
  id             String           @id @default(cuid())
  employeeId     String
  shiftId        String           @unique
  scheduledStart DateTime
  scheduledEnd   DateTime
  clockInAt      DateTime?
  clockOutAt     DateTime?
  status         AttendanceStatus
  employee       EmployeeProfile  @relation(fields: [employeeId], references: [id])
  shift          Shift            @relation(fields: [shiftId], references: [id])
  audits         AttendanceAudit[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@index([employeeId, scheduledStart])
  @@index([status, scheduledStart])
}

model AttendanceAudit {
  id           String     @id @default(cuid())
  attendanceId String
  actorUserId  String
  beforeData   Json
  afterData    Json
  reason       String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  actor        User       @relation("AttendanceAuditActor", fields: [actorUserId], references: [id])
  createdAt    DateTime   @default(now())
  @@index([attendanceId, createdAt])
}

model Review {
  id               String         @id @default(cuid())
  studentProfileId String
  productId        String
  orderItemId      String         @unique
  rating           Int
  comment          String?
  isHidden         Boolean        @default(false)
  hiddenReason     String?
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  @@index([productId, isHidden])
  @@index([studentProfileId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  @@index([userId, isRead, createdAt])
}

model ChatRoom {
  id           String            @id @default(cuid())
  orderId      String            @unique
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ChatParticipant {
  roomId     String
  userId     String
  lastReadAt DateTime?
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  @@id([roomId, userId])
  @@index([userId, lastReadAt])
}

model ChatMessage {
  id           String   @id @default(cuid())
  roomId       String
  senderUserId String
  senderRole   Role
  content      String
  readAt       DateTime?
  room         ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       User     @relation(fields: [senderUserId], references: [id])
  createdAt    DateTime @default(now())
  @@index([roomId, createdAt])
  @@index([senderUserId, createdAt])
}

model CanteenSetting {
  id                    String   @id @default("default")
  canteenName           String   @default("CanteenPN")
  logoUrl               String?
  expenses              Json     @default("[]")
  address               String
  openingTime           String   @default("07:00")
  closingTime           String   @default("18:00")
  contactInformation    String
  defaultPickupInterval Int      @default(15)
  pointValueVnd         Int      @default(100)
  comboDiscountPercent  Int      @default(10)
  timezone              String   @default("Asia/Ho_Chi_Minh")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeData  Json?
  afterData   Json?
  ipAddress   String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime @default(now())
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
